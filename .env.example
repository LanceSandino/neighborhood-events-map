# Docker Compose deployment settings. Copy to `.env` (never commit it) and fill in secrets.
# Generate secrets with:  openssl rand -hex 32

COMPOSE_PROJECT_NAME=halloween
# For local development, uncomment the next line (adds Mailpit + bind mounts):
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

APP_SECRET=
APP_BASE_URL=http://localhost:8087
HTTP_PORT=8087
# Address nginx listens on. Keep 127.0.0.1 in production (put the tunnel/proxy in front).
# For testing from phones on your home network: HTTP_BIND=0.0.0.0 and APP_BASE_URL=http://<this-computer's-LAN-IP>:<port>
HTTP_BIND=127.0.0.1

POSTGRES_DB=halloween
POSTGRES_USER=halloween
POSTGRES_PASSWORD=

# SMTP relay with domain authentication (SPF/DKIM). Dev overlay forces Mailpit.
MAILER_DSN=smtp://username:password@smtp.example.org:587
MAIL_FROM="Neighborhood Halloween <no-reply@example.org>"
# Receives dispute notices. Organizer accounts are granted with: bin/console app:admin:grant <email>
ADMIN_EMAIL=organizer@example.org
# Organizer accounts (comma-separated). Each still signs in with an email link; listing an address
# here is equivalent to `bin/console app:admin:grant <email>`. Remove it to revoke.
ORGANIZER_EMAILS=organizer@example.org

# Community config imported on first start (path inside the container; mount ./deploy/community).
# e.g. /app/deploy/community/community.yaml  or  /app/examples/demo/community.yaml
COMMUNITY_BOOTSTRAP_FILE=

# Server-enforced inactivity timeout for signed-in residents/organizers (5-240, default 30)
AUTH_SESSION_IDLE_MINUTES=30
# Absolute session lifetime after sign-in, however active (1-72, default 12)
AUTH_SESSION_MAX_HOURS=12
# One-time email link lifetime (5-60, default 15)
MAGIC_LINK_MINUTES=15
# Email-sending endpoints answer no faster than this (plus random jitter), so timing reveals nothing.
AUTH_RESPONSE_FLOOR_MS=700
AUTH_RESPONSE_JITTER_MS=250
SESSION_COOKIE_NAME=nhm_session

# Proof-of-work leading zero bits (14-17 recommended for phones)
POW_DIFFICULTY=16
# Rate limits "count/seconds" (raise per-IP limits if many neighbors share one IP)
RL_LINK_PER_EMAIL=3/900
RL_LINK_PER_IP=10/3600
RL_LINK_GLOBAL=200/3600
RL_DISPUTE_PER_IP=3/86400
RL_CLAIM_PER_USER=10/3600
RL_DISPUTE_GLOBAL=60/86400

# Optional pedestrian routing provider: none | openrouteservice
ROUTING_PROVIDER=none
ROUTING_API_KEY=

BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups

# Source-code link in the "What's new" dialog (your fork, or empty to hide). Default: the project repository.
#APP_SOURCE_URL=https://github.com/LanceSandino/neighborhood-halloween-map
