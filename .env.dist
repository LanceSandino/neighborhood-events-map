# Committed, NON-SECRET application defaults (loaded when no .env exists in the container).
# Real environment variables (Docker Compose) always win. Never put secrets here.
# Deployment secrets live in the Compose `.env` file created from `.env.example`.

APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8087
APP_BASE_URL=http://localhost:8087

DATABASE_URL="postgresql://halloween:halloween@postgres:5432/halloween?serverVersion=17&charset=utf8"
MAILER_DSN=null://null
MAIL_FROM="Neighborhood events <no-reply@example.org>"
ADMIN_EMAIL=organizer@example.org

# Community configuration bootstrap (YAML + GeoJSON); imported into the DB on first start.
COMMUNITY_BOOTSTRAP_FILE=
APP_DEMO=0

# Sessions and sign-in links (minutes). Env overrides community.yaml.
AUTH_SESSION_IDLE_MINUTES=
MAGIC_LINK_MINUTES=
AUTH_SESSION_MAX_HOURS=12
ORGANIZER_EMAILS=
AUTH_RESPONSE_FLOOR_MS=700
AUTH_RESPONSE_JITTER_MS=250
SESSION_COOKIE_NAME=nhm_session

# Proof-of-work difficulty in leading zero bits (12-22).
POW_DIFFICULTY=16
POW_TTL_SECONDS=120

# Rate limits: "count/seconds".
RL_LINK_PER_EMAIL=3/900
RL_LINK_PER_IP=10/3600
RL_LINK_PER_ADDRESS=6/3600
RL_LINK_GLOBAL=200/3600
RL_DISPUTE_PER_IP=3/86400
RL_DISPUTE_PER_ADDRESS=5/86400
RL_POW_PER_IP=40/600
RL_LOOKUP_PER_IP=120/600
RL_ROUTE_PER_IP=30/600
RL_CLAIM_PER_USER=10/3600
RL_DISPUTE_GLOBAL=60/86400
RL_LISTING_PER_USER=60/3600
RL_ROUTE_GLOBAL=1000/86400

# Optional server-side pedestrian routing: none | openrouteservice
ROUTING_PROVIDER=none
ROUTING_API_KEY=
ROUTING_BASE_URL=https://api.openrouteservice.org
