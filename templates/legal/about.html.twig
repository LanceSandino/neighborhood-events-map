{% extends 'base.html.twig' %}
{% set nav = 'about' %}
{% block title %}About · {{ c.community.name }} {{ c.event.name }}{% endblock %}
{% block body %}
{% set et = event_type(c.event.type) %}
{% set access = access_info(c.community.access ?? null, et.copy) %}
{% set type_rules %}{% if c.event.active ?? true %}{% include event_fragment(c.event.type, 'rule_lines') %}{% endif %}{% endset %}
<article class="page-card legal about">
  <div class="eyebrow">{{ c.branding.brand_emoji }} About</div>
  <h1>{{ c.community.name }} {{ c.event.name }}</h1>
  {% if c.community.subtitle %}<p class="legal-lead">{{ c.community.subtitle }}</p>{% endif %}

  <div class="about-facts">
    {% if (c.event.active ?? true) and (c.event.ends_on ?? c.event.date) != c.event.date %}<div class="about-fact"><span aria-hidden="true">{{ et.copy.event_icon }}</span><div><b>{{ c.event.days ?? false ? day_list(c.event.days) : date_range(c.event.starts_on, c.event.ends_on) }}</b><p>Most homes {{ c.event.starts_at|time12 }}–{{ c.event.ends_at|time12 }}; {{ et.copy.own_schedule ?? 'each home sets its own nights and hours' }}.</p></div></div>
    {%- elseif c.event.active ?? true %}<div class="about-fact"><span aria-hidden="true">{{ et.copy.event_icon }}</span><div><b>{{ event_badge(c.event.date)|lower|capitalize }}</b><p>Suggested hours {{ c.event.starts_at|time12 }}–{{ c.event.ends_at|time12 }}; each home sets its own.</p></div></div>
    {%- else %}<div class="about-fact"><span aria-hidden="true">📅</span><div><b>No event on the map right now</b><p>The next event's date appears here when the organizer starts it.</p></div></div>{% endif %}
    {% if c.community.locality %}<div class="about-fact"><span aria-hidden="true">📍</span><div><b>{{ c.community.locality }}{% if c.community.region %}, {{ c.community.region }}{% endif %}</b><p>{{ c.map.boundary_status == 'approved' ? 'Homes inside the neighborhood outline can take part.' : 'The neighborhood outline is still being reviewed.' }}</p></div></div>{% endif %}
    {% if access %}<div class="about-fact"><span aria-hidden="true">{{ access.icon }}</span><div><b>{{ access.title }}</b><p>{{ access.text }}</p></div></div>{% endif %}
  </div>

  <nav class="about-connect" aria-label="Links and contact">
    {% for l in c.community.links ?? [] %}<a class="pill-link" href="{{ l.url }}" rel="noopener noreferrer"><span aria-hidden="true">🔗</span>{{ l.label }}</a>{% endfor %}
    {% if c.community.contact_url %}<a class="pill-link" href="{{ c.community.contact_url }}" rel="noopener"><span aria-hidden="true">✉️</span>Contact the organizer</a>{% endif %}
    <a class="pill-link accent" href="/"><span aria-hidden="true">🗺️</span>Open the map</a>
  </nav>
  {% if not c.community.contact_url %}<p class="form-caption">Questions about the event, a listing or your data? {% include 'legal/_contact.html.twig' %}.</p>{% endif %}

  {% if c.community.gate_notice or c.map.crossing_notes %}
  <div class="about-notes">
    {% if c.community.gate_notice %}<div class="notice" role="note">🚪 {{ c.community.gate_notice }}</div>{% endif %}
    {% for note in c.map.crossing_notes %}<div class="notice" role="note">🚸 {{ note }}</div>{% endfor %}
  </div>
  {% endif %}

  <section class="about-section" aria-labelledby="aboutTitle">
    <h2 id="aboutTitle">About</h2>
    {% if c.community.about %}
      {% for para in c.community.about|split("\n\n") %}<p>{{ para|nl2br }}</p>{% endfor %}
    {% else %}
      <p>{{ et.copy.about }}</p>
    {% endif %}
  </section>

  {% if (c.event.rules ?? []) or type_rules|trim %}<section class="about-section" aria-labelledby="eventRules">
    <h2 id="eventRules">Event rules</h2>
    <ul class="reminders two-col">{% for r in c.event.rules ?? [] %}<li>{{ r }}</li>{% endfor %}{{ type_rules }}</ul>
  </section>

  {% endif %}<section class="about-section" aria-labelledby="reminders">
    <h2 id="reminders">{{ et.copy.reminders_heading }}</h2>
    <ul class="reminders two-col">{% for r in c.community.reminders %}<li>{{ r }}</li>{% endfor %}</ul>
  </section>

  <div class="modal-actions"><a class="secondary" href="/#list-my-house" data-action="register">🏠 List your home</a><a class="primary" href="/">Open the map</a></div>
</article>
{% endblock %}
