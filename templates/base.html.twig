{# Shared shell: dark navigation rail (desktop), top bar, mobile bottom navigation. #}
{%- set community = c.community -%}
{%- set branding = c.branding -%}
{%- set year = c.event.date|slice(0, 4) -%}
{%- set event_name = c.event.name -%}
{%- set place = community.locality ? community.locality ~ (community.region ? ', ' ~ community.region : '') : '' -%}
{%- set show_place = (branding.show_locality ?? false) and place -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f7f4">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15141d">
  <script src="{{ asset_path('js/theme-init.js') }}"></script>
  <meta name="description" content="{{ community.name }} {{ event_name }}: a neighborhood map of the homes taking part, with their hours and what each offers.">
  {% block meta %}{% endblock %}
  <title>{% block title %}{{ community.name }} {{ event_name }}{% endblock %}</title>
  <link rel="icon" href="{{ branding.logo_url ?? '/assets/img/favicon.svg' }}">
  <link rel="preload" href="/fonts/nunito-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% block styles %}{% endblock %}
  <link rel="stylesheet" href="{{ asset_path('css/app.css') }}">
  <link rel="stylesheet" href="/theme.css?v={{ app_version }}">
</head>
<body class="{% block body_class %}{% endblock %}">
<a class="skip-link" href="#main">Skip to content</a>
<div class="app">
  <aside class="sidebar" aria-label="Site">
    <a class="brand" href="/">
      <div class="brand-icon{{ branding.logo_url ? ' has-logo' }}" aria-hidden="true">{% if branding.logo_url %}<img src="{{ branding.logo_url }}" alt="">{% else %}{{ branding.brand_emoji }}{% endif %}</div>
      <div><div class="brand-name">{{ community.name }}<br>{{ event_name }}</div><div class="brand-sub">{{ show_place ? place ~ ' · ' ~ year : 'Community ' ~ year }}</div></div>
    </a>
    <div>
      <div class="nav-title" id="nav-title">EXPLORE</div>
      <nav class="nav" aria-labelledby="nav-title">
        {% set nav = nav ?? 'map' %}
        {# The same three places as the phone tabs (Map · Rules · My house); My route lives on the map page. #}
        <a href="/#explore" class="{{ nav == 'map' ? 'active' }}" data-action="explore" {% if nav == 'map' %}aria-current="page"{% endif %}><span class="nav-icon" aria-hidden="true">🗺️</span> Map</a>
        <a href="/#info" class="{{ nav == 'about' ? 'active' }}" data-action="info" {% if nav == 'about' %}aria-current="page"{% endif %}><span class="nav-icon" aria-hidden="true">📋</span> Rules</a>
        <a href="/#my-house" class="{{ nav == 'me' ? 'active' }}" data-action="house" {% if nav == 'me' %}aria-current="page"{% endif %}><span class="nav-icon" aria-hidden="true">🏠</span> My house</a>
      </nav>
    </div>
    <div class="side-bottom">
      <div class="side-panel">
        <div class="ghost" aria-hidden="true">👻</div>
        <b>Handing out treats?</b>
        <p>Put your home on the map so the neighborhood can find you!</p>
        <a class="side-action secondary" href="/#list-my-house" data-action="register">+ Add your house</a>
      </div>
      <p class="side-fine">Made for {{ community.name }} neighbors&nbsp;♥{% if c.demo %}<br>Fictional demo data{% endif %}</p>
    </div>
  </aside>
  <div class="main">
    <header class="topline">
      <a class="crumb" href="/">{% if branding.logo_url %}<img class="crumb-logo" src="{{ branding.logo_url }}" alt="">{% else %}📍{% endif %} {% if place and not show_place %}<span class="crumb-loc">{{ place }} <span class="sep">/</span> </span>{% endif %}<span class="crumb-name"><strong>{{ community.name }} Community</strong>{% if show_place %}<small class="crumb-sub">{{ place }}</small>{% endif %}</span></a>
      <div class="topright">
        {% if c.demo %}<span class="demo-pill">FICTIONAL DEMO</span>{% elseif c.map.boundary_status == 'pending_review' %}<span class="demo-pill warn" title="House listings open after the organizer approves the boundary">SETUP IN REVIEW</span>{% endif %}
        <a class="event-pill" href="/about" title="Event date, hours and reminders">🎃 {{ event_badge(c.event.date) }}</a>
        <button type="button" class="top-icon" data-appearance aria-haspopup="dialog" aria-controls="appearanceDialog" aria-label="Appearance and accessibility" title="Appearance and accessibility"><span aria-hidden="true">🎨</span></button>
        <a class="top-add" href="/#list-my-house" data-action="register">+ List your home</a>
      </div>
    </header>
    <main class="content" id="main" tabindex="-1">
      {% block body %}{% endblock %}
    </main>
    <footer class="site-footer"><a href="/about">About</a><a href="/privacy">Privacy</a><a href="/terms">Terms of use</a><a href="/accessibility">Accessibility</a><span>No ads · No tracking</span><span class="footer-id">{{ community.name }} {{ event_name }} · <a href="/changelog" data-whats-new>v{{ app_version }} · What’s new</a></span>{% block footer_credit %}{% endblock %}</footer>
  </div>
</div>
<nav class="mobile-bottom" aria-label="Primary">
  <a href="/#explore" class="{{ (nav ?? 'map') == 'map' ? 'active' }}" data-action="explore"><span aria-hidden="true">🗺️</span>Map</a>
  <a href="/#info" data-action="info"><span aria-hidden="true">📋</span>Rules</a>
  <a href="/#my-house" data-action="house" class="{{ (nav ?? '') == 'me' ? 'active' }}"><span aria-hidden="true">🏠</span>My house</a>
</nav>
{% block modals %}{% endblock %}
<dialog class="whats-new" id="whatsNew" aria-labelledby="whatsNewTitle">
  <button type="button" class="close-modal" data-whats-new-close aria-label="Close">×</button>
  <div class="eyebrow">✨ Version {{ app_version }}</div>
  <h2 id="whatsNewTitle">What’s new</h2>
  <p class="introtext">Free, open-source software any neighborhood can run.</p>
  {% include 'partials/_releases.html.twig' with {releases: latest_changes(3)} %}
  {% include 'partials/_source_links.html.twig' %}
</dialog>
<script type="module" src="{{ asset_path('js/whatsnew.js') }}"></script>
<dialog class="whats-new appearance" id="appearanceDialog" aria-labelledby="appearanceTitle">
  <button type="button" class="close-modal" data-appearance-close aria-label="Close">×</button>
  <div class="eyebrow">🎨 Make it comfortable</div>
  <h2 id="appearanceTitle">Appearance</h2>
  <div class="seg" role="group" aria-label="Colour theme"><button type="button" data-pref="theme" data-value="auto">🌓 Auto</button><button type="button" data-pref="theme" data-value="light">☀️ Light</button><button type="button" data-pref="theme" data-value="dark">🌙 Dark</button></div>
  <p class="form-caption">Auto follows your phone or computer’s setting.</p>
  <h3 class="pref-heading">Accessibility</h3>
  <label class="pref-row"><span><b>Larger text</b><small>Bigger words and buttons across the site.</small></span><input type="checkbox" data-pref="text" data-value="large"></label>
  <label class="pref-row"><span><b>More contrast</b><small>Darker text and stronger outlines.</small></span><input type="checkbox" data-pref="contrast" data-value="more"></label>
  <label class="pref-row"><span><b>Reduce motion</b><small>No smooth scrolling or animated map moves.</small></span><input type="checkbox" data-pref="motion" data-value="reduce"></label>
  <p class="form-caption">Saved on this device only. Your device’s own accessibility settings are always respected too.</p>
  <div class="modal-actions"><button type="button" class="secondary" data-appearance-reset>Reset</button><button type="button" class="primary" data-appearance-close>Done</button></div>
</dialog>
<button type="button" class="to-top" id="toTop" aria-label="Back to top" title="Back to top" hidden><span aria-hidden="true">↑</span></button>
<script type="module" src="{{ asset_path('js/appearance.js') }}"></script>
<script type="module" src="{{ asset_path('js/to-top.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
