{# Shared shell: dark navigation rail (desktop), top bar, mobile bottom navigation. Between events (no public
   event) the shell names only the community and offers no listing action; a closed event offers none either. A long
   community or event name gets the compact brand, and a long name wraps in the footer instead of widening a phone page.
   <html data-event-type> names the type of the event the page shows (the selected or the default one), whose head
   fragment may add its theme tokens (organizer colours from /theme.css still win). A page that sets switch_path ('/' or
   '/me') shows the event switcher while several events are current (ADR 0011); links keep the page's event (event_query).
   While a closed event exists, the map's pages end that row with a "Past events" link and every footer has one
   (D-20261104-02); without one nothing changes.
   The browser-tab icon is the page's logo, else the type's drawn mark (between events the community's); the theme stylesheet (block theme) is the page's
   event's colours (the draft preview names its draft's). #}
{%- set community = c.community -%}
{%- set branding = c.branding -%}
{%- set event_on = c.event.active ?? true -%}
{%- set listing_on = event_on and (c.event.state ?? 'open') != 'closed' -%}
{%- set q = event_query() -%}
{%- set tabs = (switch_path ?? '') ? event_tabs(switch_path) : [] -%}
{%- set past = past_events() -%}
{%- set show_past = past and (switch_path ?? '') == '/' -%}
{%- set past_page = past_page ?? false -%}
{%- set year = c.event.date|slice(0, 4) -%}
{%- set event_name = event_on ? c.event.name : '' -%}
{%- set et = event_type(c.event.type ?? null) -%}
{%- set place = community.locality ? community.locality ~ (community.region ? ', ' ~ community.region : '') : '' -%}
{%- set show_place = (branding.show_locality ?? false) and place -%}
{#- A name longer than the rail's column (about 12 characters at full size) gets the compact brand (app.css .brand.long). -#}
{%- set brand_long = max(community.name|length, event_name|length) > 12 -%}
<!doctype html>
<html lang="en" data-event-type="{{ et.key }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f7f4">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15141d">
  <script src="{{ asset_path('js/theme-init.js') }}"></script>
  <meta name="description" content="{{ (community.name ~ ' ' ~ event_name)|trim }}: a neighborhood map of the homes taking part, with their hours and what each offers.">
  {% block meta %}{% endblock %}
  <title>{% block title %}{{ (community.name ~ ' ' ~ event_name)|trim }}{% endblock %}</title>
  <link rel="icon" href="{{ branding.logo_url ?? (event_on ? et.copy.page_favicon : '/assets/img/favicon-community.svg') }}">
  <link rel="preload" href="/fonts/nunito-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% block styles %}{% endblock %}
  <link rel="stylesheet" href="{{ asset_path('css/app.css') }}">
  {%- include event_fragment(et.key, 'head') %}

  {% block theme %}<link rel="stylesheet" href="/theme.css?v={{ app_version }}{{ q ? '&' ~ q|slice(1) }}">{% endblock %}{{ "\n" }}</head>
<body class="{% block body_class %}{% endblock %}">
<a class="skip-link" href="#main">Skip to content</a>
<div class="app">
  <aside class="sidebar" aria-label="Site">
    <a class="brand{{ brand_long ? ' long' }}" href="/{{ q }}">
      <div class="brand-icon{{ branding.logo_url ? ' has-logo' }}" aria-hidden="true">{% if branding.logo_url %}<img src="{{ branding.logo_url }}" alt="">{% else %}{{ brand_mark(event_on ? et.copy.brand_mark : 'brand-community') }}{% endif %}</div>
      <div><div class="brand-name">{{ community.name }}{% if event_name %}<br>{{ event_name }}{% endif %}</div><div class="brand-sub">{{ show_place ? place ~ ' · ' ~ year : 'Community ' ~ year }}</div></div>
    </a>
    <div>
      <div class="nav-title" id="nav-title">EXPLORE</div>
      <nav class="nav" aria-labelledby="nav-title">
        {% set nav = nav ?? 'map' %}
        {# The same three places as the phone tabs (Map · Rules · My house); My route lives on the map page. #}
        <a href="/{{ q }}#explore" class="{{ nav == 'map' ? 'active' }}" data-action="explore" {% if nav == 'map' %}aria-current="page"{% endif %}><span class="nav-icon" aria-hidden="true">{{ icon('i-map') }}</span> Map</a>
        <a href="/{{ q }}#info" class="{{ nav == 'about' ? 'active' }}" data-action="info" {% if nav == 'about' %}aria-current="page"{% endif %}><span class="nav-icon" aria-hidden="true">{{ icon('i-rules') }}</span> Rules</a>
        <a href="/{{ q }}#my-house" class="{{ nav == 'me' ? 'active' }}" data-action="house" {% if nav == 'me' %}aria-current="page"{% endif %}><span class="nav-icon" aria-hidden="true">{{ icon('i-house') }}</span> My house</a>
      </nav>
    </div>
    <div class="side-bottom">
      {% if listing_on %}<div class="side-panel">
        <div class="side-icon" aria-hidden="true">{{ icon(et.copy.cta_icon) }}</div>
        <b>{{ et.copy.cta_title }}</b>
        <p>{{ et.copy.cta_text }}</p>
        <a class="side-action secondary" href="/{{ q }}#list-my-house" data-action="register">+ Add your house</a>
      </div>{% endif %}
      <p class="side-fine">Made for {{ community.name }} neighbors&nbsp;{{ icon("i-heart-filled") }}{% if c.demo %}<br>Fictional demo data{% endif %}</p>
    </div>
  </aside>
  <div class="main">
    <header class="topline{{ tabs or show_past ? ' has-switch' }}">
      <a class="crumb" href="/{{ q }}">{% if branding.logo_url %}<img class="crumb-logo" src="{{ branding.logo_url }}" alt="">{% else %}{{ icon("i-pin") }}{% endif %} {% if place and not show_place %}<span class="crumb-loc">{{ place }} <span class="sep">/</span> </span>{% endif %}<span class="crumb-name"><strong>{{ community.name }} Community</strong>{% if show_place %}<small class="crumb-sub">{{ place }}</small>{% endif %}</span></a>
      <div class="topright">
        {% if c.demo %}<span class="demo-pill">FICTIONAL DEMO</span>{% elseif c.map.boundary_status == 'pending_review' %}<span class="demo-pill warn" title="House listings open after the organizer approves the boundary">SETUP IN REVIEW</span>{% endif %}
        {% if event_on %}<a class="event-pill" href="/about{{ q }}" title="Event date, hours and reminders">{{ icon(et.copy.event_icon) }} {{ c.event.starts_on is defined and c.event.starts_on is null ? 'Dates TBA' : event_badge(c.event.date, c.event.ends_on ?? null) }}</a>{% endif %}
        <button type="button" class="top-icon" data-appearance aria-haspopup="dialog" aria-controls="appearanceDialog" aria-label="Appearance and accessibility" title="Appearance and accessibility"><span aria-hidden="true">{{ icon('i-appearance') }}</span></button>
        {% if listing_on %}<a class="top-add" href="/{{ q }}#list-my-house" data-action="register">+ List your home</a>{% endif %}
      </div>
    </header>
    {% if tabs or show_past %}<div class="event-switch-bar">
      {%- if tabs %}<nav class="event-switch" aria-label="Events">
      {%- for t in tabs %}{% set here = t.current and not past_page %}<a href="{{ t.href }}" class="event-tab{{ here ? ' current' }}"{% if here %} aria-current="page"{% endif %}><span class="event-tab-icon" aria-hidden="true">{{ icon(t.icon) }}</span><span class="event-tab-name">{{ t.label }}</span>{% if t.state_words %}<span class="event-tab-state">{{ t.state_words }}</span>{% endif %}</a>{% endfor -%}
    </nav>{% endif -%}
      {%- if show_past %}{% set past_here = past_page or (c.event.state ?? '') == 'closed' %}<a class="past-link{{ past_here ? ' current' }}" href="/past-events"{% if past_here %} aria-current="{{ past_page ? 'page' : 'true' }}"{% endif %}>Past events</a>{% endif -%}
    </div>{% endif %}
    {%- if event_on %}{% include event_fragment(et.key, 'decor') %}{% endif %}
    <main class="content" id="main" tabindex="-1">
      {% block body %}{% endblock %}
    </main>
    <footer class="site-footer"><a href="/about{{ q }}">About</a>{% if past %}<a href="/past-events">Past events</a>{% endif %}<a href="/privacy">Privacy</a><a href="/terms">Terms of use</a><a href="/accessibility">Accessibility</a><span>{{ cloudflare_web_analytics ? 'No ads · Cookie-free visit statistics' : 'No ads · No tracking' }}</span><span class="footer-id">{{ (community.name ~ ' ' ~ event_name)|trim }} · <a href="/changelog" data-whats-new>v{{ app_version }} · What’s new</a></span>{% block footer_credit %}{% endblock %}</footer>
  </div>
</div>
<nav class="mobile-bottom" aria-label="Primary">
  <a href="/{{ q }}#explore" class="{{ (nav ?? 'map') == 'map' ? 'active' }}" data-action="explore"><span aria-hidden="true">{{ icon('i-map') }}</span>Map</a>
  <a href="/{{ q }}#info" data-action="info"><span aria-hidden="true">{{ icon('i-rules') }}</span>Rules</a>
  <a href="/{{ q }}#my-house" data-action="house" class="{{ (nav ?? '') == 'me' ? 'active' }}"><span aria-hidden="true">{{ icon('i-house') }}</span>My house</a>
</nav>
{% block modals %}{% endblock %}
<dialog class="whats-new" id="whatsNew" aria-labelledby="whatsNewTitle">
  <button type="button" class="close-modal" data-whats-new-close aria-label="Close">{{ icon("i-close") }}</button>
  <div class="eyebrow">{{ icon("i-party") }} Version {{ app_version }}</div>
  <h2 id="whatsNewTitle">What’s new</h2>
  <p class="introtext">Free, open-source software any neighborhood can run.</p>
  {% include 'partials/_releases.html.twig' with {releases: latest_changes(3)} %}
  {% include 'partials/_source_links.html.twig' %}
</dialog>
<script type="module" src="{{ asset_path('js/whatsnew.js') }}"></script>
<dialog class="whats-new appearance" id="appearanceDialog" aria-labelledby="appearanceTitle">
  <button type="button" class="close-modal" data-appearance-close aria-label="Close">{{ icon("i-close") }}</button>
  <div class="eyebrow">{{ icon("i-appearance") }} Make it comfortable</div>
  <h2 id="appearanceTitle">Appearance</h2>
  <div class="seg" role="group" aria-label="Colour theme"><button type="button" data-pref="theme" data-value="auto">{{ icon('i-theme-auto') }} Auto</button><button type="button" data-pref="theme" data-value="light">{{ icon('i-sun') }} Light</button><button type="button" data-pref="theme" data-value="dark">{{ icon('i-moon') }} Dark</button></div>
  <p class="form-caption">Auto follows your phone or computer’s setting.</p>
  <h3 class="pref-heading">Accessibility</h3>
  <label class="pref-row"><span><b>Larger text</b><small>Bigger words and buttons across the site.</small></span><input type="checkbox" data-pref="text" data-value="large"></label>
  <label class="pref-row"><span><b>More contrast</b><small>Darker text and stronger outlines.</small></span><input type="checkbox" data-pref="contrast" data-value="more"></label>
  <label class="pref-row"><span><b>Reduce motion</b><small>No smooth scrolling or animated map moves.</small></span><input type="checkbox" data-pref="motion" data-value="reduce"></label>
  <p class="form-caption">Saved on this device only. Your device’s own accessibility settings are always respected too.</p>
  <div class="modal-actions"><button type="button" class="secondary" data-appearance-reset>Reset</button><button type="button" class="primary" data-appearance-close>Done</button></div>
</dialog>
<button type="button" class="to-top" id="toTop" aria-label="Back to top" title="Back to top" hidden>{{ icon("i-arrow-up") }}</button>
<script type="module" src="{{ asset_path('js/appearance.js') }}"></script>
<script type="module" src="{{ asset_path('js/to-top.js') }}"></script>
{% if tabs %}<script type="module" src="{{ asset_path('js/event-switch.js') }}"></script>{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
