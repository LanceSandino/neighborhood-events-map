{# "My route" on the map page (route-panel.js fills it; hidden without JavaScript). A suggested stop order, never walking
   directions. The event type may name it ("Your lights tour") and add its rules (route_rules fragment). #}
<section class="route-pane empty" id="route" aria-labelledby="routeTitle" hidden>
  <div class="route-head">
    <div><h2 id="routeTitle" tabindex="-1">{{ et.copy.route_title ?? '🧭 My route' }}</h2><p class="route-meta"><span id="savedCount">0</span> saved ♡</p></div>
    <div class="route-actions route-planned"><button type="button" class="secondary" id="btnRouteMap">🗺️ Show on map</button><button type="button" class="primary" id="btnShareRoute">↗ Share</button></div>
  </div>
  <div class="route-pick" id="routePickRow">
    <select id="routePick" aria-label="Saved routes"></select>
    <button type="button" class="link-button" id="btnSaveRoute">💾 Save route</button>
    <button type="button" class="link-button" id="btnDeleteRoute">Delete</button>
  </div>
  <form class="route-name" id="routeNameForm" hidden>
    <label for="routeName">Name this route</label>
    <div><input id="routeName" maxlength="40" autocomplete="off" placeholder="e.g. Little kids"><button type="submit" class="primary">Save</button><button type="button" class="secondary" id="btnCancelRouteName">Cancel</button></div>
  </form>
  <p class="introtext" id="routeSub"></p>
  <div class="field full route-planned"><label for="routeStart">Start from</label><select id="routeStart"><option value="">The first stop in each area</option></select></div>
  <div id="routeItems" aria-live="polite"></div>
  <div class="notice route-planned" id="routeNotice">🚸 A suggested order of stops, not walking directions. It never connects separate areas across major roads, water or gates. Use sidewalks and marked crossings.</div>
  {% for note in c.map.crossing_notes %}<div class="notice route-planned">⚠️ {{ note }}</div>{% endfor %}
  {%- include event_fragment(c.event.type, 'route_rules') %}
</section>
