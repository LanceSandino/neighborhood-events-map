{% extends 'base.html.twig' %}
{# Public family map. Mirrors prototype/index.html: hero, stats chips, search/filter row,
   list + real Leaflet map, bottom bar, modals. Works as a readable list without JavaScript. The community's event
   type supplies the words, filters, legend and fragments (Twig/EventTypeExtension). #}
{% set nav = 'map' %}
{% set et = event_type(c.event.type) %}
{% set zones = c.zones %}
{% set zs = zone_summary(zones) %}
{# Map styles load from home.js without blocking the first paint; open the connection to the tile server early. #}
{% block styles %}{% set tile_origin = c.map.tiles.url|split('/')|slice(0, 3)|join('/') %}<link rel="preconnect" href="{{ tile_origin }}" crossorigin><link rel="dns-prefetch" href="{{ tile_origin }}">{% endblock %}
{% block footer_credit %}<span>Map data © OpenStreetMap contributors</span>{% endblock %}
{% block body %}
<section class="intro">
  <div>
    <div class="eyebrow">✦ {{ c.community.subtitle }}</div>
    <h1>{{ c.branding.headline }} <span>{{ c.branding.headline_accent }}</span></h1>
    <p>{{ c.branding.intro }}{% if c.community.name %} All across {{ c.community.name }}.{% endif %}</p>
  </div>
  <div class="hero-illustration" aria-hidden="true">{% include event_fragment(c.event.type, 'hero_art') %}</div>
</section>
{%- include event_fragment(c.event.type, 'schedule_row') %}

<section id="explore" aria-label="{{ et.copy.explore_label }}">
  <div class="controls">
    <div class="search"><input id="search" type="search" placeholder="{{ et.copy.search_placeholder }}" aria-label="Search homes" autocomplete="off"></div>
    {% if zones|length > 0 %}
    <div class="phase-wrap"><span class="fi" aria-hidden="true">📍</span>
    <select class="phase-select" id="zone" aria-label="Filter by {{ zs ? zs.title|split(' ')|last : 'zone' }}">
      {% set word = zs ? zs.title|split(' ')|last : 'zones' %}
      {% set areas = zone_areas(zones, c.routing.groups, c.routing.group_labels ?? []) %}
      <option value="all" data-label="All {{ word }}">All {{ word }}</option>
      {% if areas %}<optgroup label="Walking areas">{% for a in areas %}<option value="{{ a.value }}" data-label="{{ a.label }}">{{ a.label }}</option>{% endfor %}</optgroup><optgroup label="{{ word|capitalize }}">{% endif %}
      {% for z in zones %}{% if z.residential and z.status == 'active' %}<option value="{{ z.key }}" data-label="{{ z.label }}">{{ z.label }}</option>{% endif %}{% endfor %}
      {% if areas %}</optgroup>{% endif %}
    </select>
    </div>
    {% endif %}
    {# Quick filters: icon + count everywhere; the name is visually hidden text (screen readers) and the title (hover). #}
    <div class="quick-filters">
      {% for f in et.filters|filter(f => f.quick and (f.feature is null or (c.features[f.feature] ?? false))) %}
      <button type="button" class="filter-button"{% if f.id is defined %} id="{{ f.id }}"{% endif %} data-filter="{{ f.key }}" aria-pressed="false" title="{{ f.label }}"><span class="fi{% if f.icon_class is defined %} {{ f.icon_class }}{% endif %}" aria-hidden="true">{{ f.icon }}</span><span class="sr-only">{{ f.label }}</span></button>
      {% endfor %}
      <button type="button" class="filter-button" data-filter="saved" aria-pressed="false" title="Saved only"><span class="fi" aria-hidden="true">🧡</span><span class="sr-only">Saved only</span></button>
    </div>
    <button type="button" class="filter-button" id="btnFilters" aria-expanded="false" aria-controls="moreFilters"><span class="fi" aria-hidden="true">⚙️</span>Filters<span class="filter-count hide" id="filterCount"></span></button>
  </div>
  <div class="filter-more" id="moreFilters" role="group" aria-label="More filters">
    {% for f in et.filters|filter(f => not f.quick and (f.feature is null or (c.features[f.feature] ?? false))) %}
    <button type="button" class="mini-filter" data-filter="{{ f.key }}" aria-pressed="false"{% if f.title is defined %} title="{{ f.title }}"{% endif %}><span class="fi{% if f.icon_class is defined %} {{ f.icon_class }}{% endif %}" aria-hidden="true">{{ f.icon }}</span>{{ f.label }}</button>
    {% endfor %}
    {% include event_fragment(c.event.type, 'filter_controls') %}
    <button type="button" class="link-button hide" id="btnReset">Reset filters</button>
  </div>
  <div class="workarea">
    <div class="list-pane">
      <div class="list-head"><h2>{{ et.copy.list_heading }}</h2><div class="list-tools"><span id="listCount" aria-live="polite">{{ homes|length }} showing</span><div class="view-toggle" role="group" aria-label="List layout"><button type="button" data-view="cards" aria-pressed="true" aria-label="Cards" title="Cards">▦</button><button type="button" data-view="compact" aria-pressed="false" aria-label="Compact list" title="Compact list">☰</button></div></div></div>
      <div class="list-sub" id="listSub">{% if homes|length == 0 %}No homes have listed yet — check back soon!{% else %}Self-reported by residents · tap a card to see it on the map{% endif %}</div>
      <ul class="cards" id="homeCards" aria-label="Participating homes">
        {% for home in homes %}{% include 'home/_card.html.twig' with {home: home, zones: zones, type: c.event.type} only %}{% else %}<li class="empty">No homes are listed yet. Residents can add theirs with “List your home”.</li>{% endfor %}
      </ul>
    </div>
    <div class="map-pane" id="mapPane">
      <div class="map-stage">
      <div class="map-fallback" id="mapFallback">Loading the map… The list of homes works without it.</div>
      <div class="map" id="map" role="region" aria-label="Map of participating homes"></div>
      <div class="map-logo">🗺️ {{ c.community.name }} <span>· {{ c.map.boundary_status == 'approved' ? 'neighborhood map' : 'map' }}</span></div>
      <div class="map-tools">
        <button type="button" id="btnFit" aria-label="Show the whole neighborhood" title="Show the whole neighborhood">⌖</button>
        <button type="button" id="btnZoomIn" aria-label="Zoom in" title="Zoom in">+</button>
        <button type="button" id="btnZoomOut" aria-label="Zoom out" title="Zoom out">−</button>
        <button type="button" id="btnLocate" aria-label="Show my location (stays on this device)" title="Show my location (stays on this device)">◎</button>
        <button type="button" data-action="info" aria-label="Map information" title="Map information">ⓘ</button>
      </div>
      <div class="map-selected" id="mapSelected" role="dialog" aria-label="Selected home"></div>
      <div class="map-legend" aria-hidden="true">{% for l in et.legend|filter(l => l.feature is null or (c.features[l.feature] ?? false)) %}<span><i class="legend-bullet {{ l.cls }}"></i>{{ l.icon }} {{ l.label }}</span>{% endfor %}</div>
      </div>
      <div class="map-footer"><span>⚠️ Listings are self-reported. Pins show only homes that chose to participate.</span><strong id="footerZones">{% if zs %}{{ zs.title }}{% endif %}</strong></div>
    </div>
    {% include 'home/_route.html.twig' %}
  </div>
</section>

<p class="disclaimer">{{ et.copy.disclaimer }} Favorites, filters and your start point stay only in this browser. Suggested stop orders are not walking directions—use sidewalks and safe crossings{% if c.community.gate_notice %}. {{ c.community.gate_notice }}{% else %}; this site does not grant access to gated areas{% endif %}.</p>
<script type="application/json" id="boot">{{ boot|boot_json }}</script>
{% endblock %}

{% block modals %}
{% include 'home/_modals.html.twig' %}
{% endblock %}

{% block scripts %}
<script src="/vendor/leaflet/leaflet.js" defer></script>
<script type="module" src="{{ asset_path('js/home.js') }}"></script>
{% endblock %}
