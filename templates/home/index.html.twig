{% extends 'base.html.twig' %}
{# Public family map. Mirrors prototype/index.html: hero, stats chips, search/filter row,
   list + real Leaflet map, bottom bar, modals. Works as a readable list without JavaScript. #}
{% set nav = 'map' %}
{% set zones = c.zones %}
{% set zs = zone_summary(zones) %}
{% block styles %}<link rel="stylesheet" href="/vendor/leaflet/leaflet.css">{% endblock %}
{% block footer_credit %}<span>Map data © OpenStreetMap contributors</span>{% endblock %}
{% block body %}
<section class="intro">
  <div>
    <div class="eyebrow">✦ {{ c.community.subtitle }}</div>
    <h1>{{ c.branding.headline }} <span>{{ c.branding.headline_accent }}</span></h1>
    <p>{{ c.branding.intro }}{% if c.community.name %} All across {{ c.community.name }}.{% endif %}</p>
  </div>
  <div class="hero-illustration" aria-hidden="true"><span class="hero-star one">✦</span><span class="hero-moon">🌕</span><span class="hero-ghost">👻</span><span class="hero-star two">✧</span></div>
</section>

<div class="metrics" aria-label="Neighborhood summary">
  {% if zs %}
  <div class="metric"><div class="metric-icon" aria-hidden="true">📍</div><div><b>{{ zs.title }}</b><span>{{ zs.sub }}</span></div></div>
  {% else %}
  <div class="metric"><div class="metric-icon" aria-hidden="true">🕔</div><div><b>{{ c.event.starts_at|time12|replace({' PM': '', ' AM': ''}) }}–{{ c.event.ends_at|time12 }}</b><span>Suggested hours</span></div></div>
  {% endif %}
  <div class="metric"><div class="metric-icon" aria-hidden="true">🏘️</div><div><b id="statHomes">{{ c.stats.homes }}</b><span>Participating homes</span></div></div>
  <div class="metric"><div class="metric-icon" aria-hidden="true">🧩</div><div><b id="statGentle">{{ c.stats.low_sensory }}</b><span>Sensory-friendly stops</span></div></div>
  {% if c.features.adult_refreshments %}
  <div class="metric"><div class="metric-icon" aria-hidden="true">🍺</div><div><b id="statAdult">{{ c.stats.adult }}</b><span>21+ refreshments</span></div></div>
  {% else %}
  <div class="metric"><div class="metric-icon" aria-hidden="true">🍬</div><div><b id="statCandy">{{ c.stats.candy }}</b><span>With candy</span></div></div>
  {% endif %}
</div>

<section id="explore" aria-label="Find treat stops">
  <div class="controls">
    <div class="search"><input id="search" type="search" placeholder="Search streets, treats, or notes…" aria-label="Search homes" autocomplete="off"></div>
    {% if zones|length > 0 %}
    <div class="phase-wrap"><span class="fi" aria-hidden="true">📍</span>
    <select class="phase-select" id="zone" aria-label="Filter by {{ zs ? zs.title|split(' ')|last : 'zone' }}">
      {% set word = zs ? zs.title|split(' ')|last : 'zones' %}
      {% set areas = zone_areas(zones, c.routing.groups, c.routing.group_labels ?? []) %}
      <option value="all" data-label="All {{ word }}">All {{ word }}</option>
      {% if areas %}<optgroup label="Walking areas">{% for a in areas %}<option value="{{ a.value }}" data-label="{{ a.label }}">{{ a.label }}</option>{% endfor %}</optgroup><optgroup label="{{ word|capitalize }}">{% endif %}
      {% for z in zones %}{% if z.residential and z.status == 'active' %}<option value="{{ z.key }}" data-label="{{ z.label }}">{{ z.label }}</option>{% endif %}{% endfor %}
      {% if areas %}</optgroup>{% endif %}
    </select>
    </div>
    {% endif %}
    {% if c.features.candy %}<button type="button" class="filter-button" id="btnCandy" data-filter="candy" aria-pressed="false"><span class="fi" aria-hidden="true">🍬</span>Candy</button>{% endif %}
    {% if c.features.sensory_filters %}<button type="button" class="filter-button" id="btnQuiet" data-filter="lowSensory" aria-pressed="false"><span class="fi" aria-hidden="true">🧩</span>Sensory-friendly</button>{% endif %}
    <button type="button" class="filter-button" id="btnFilters" aria-expanded="false" aria-controls="moreFilters"><span class="fi" aria-hidden="true">⚙️</span>Filters<span class="filter-count hide" id="filterCount"></span></button>
  </div>
  <div class="filter-more" id="moreFilters" role="group" aria-label="More filters">
    {% if c.features.sensory_filters %}
    <button type="button" class="mini-filter" data-filter="noScares" aria-pressed="false" title="No jump scares or intense setups"><span class="fi" aria-hidden="true">😱</span>No big scares</button>
    <button type="button" class="mini-filter" data-filter="noFlashing" aria-pressed="false"><span class="fi" aria-hidden="true">🔦</span>No flashing lights</button>
    <button type="button" class="mini-filter" data-filter="noLoud" aria-pressed="false"><span class="fi" aria-hidden="true">🔊</span>No loud audio</button>
    {% endif %}
    {% if c.features.nonfood_treats %}<button type="button" class="mini-filter" data-filter="nonfood" aria-pressed="false"><span class="fi teal-pumpkin" aria-hidden="true">🎃</span>Non-food treats</button>{% endif %}
    {% if c.features.adult_refreshments %}<button type="button" class="mini-filter" data-filter="adult" aria-pressed="false"><span class="fi" aria-hidden="true">🍺</span>21+ refreshments</button>{% endif %}
    <button type="button" class="mini-filter" data-filter="stroller" aria-pressed="false"><span class="fi" aria-hidden="true">👶</span>Kid-friendly</button>
    <button type="button" class="mini-filter" data-filter="saved" aria-pressed="false"><span class="fi" aria-hidden="true">🧡</span>Saved only</button>
    <label class="time-filter"><span class="fi" aria-hidden="true">🕐</span>Visit at
      <select id="time">
        <option value="any">Any time</option>
        <option value="now">Open now</option>
        {% for h in 15..22 %}<option value="{{ '%02d'|format(h) }}:00">{{ ('%02d:00'|format(h))|time12 }}</option>{% endfor %}
      </select>
    </label>
    <button type="button" class="link-button hide" id="btnReset">Reset filters</button>
  </div>
  <div class="workarea">
    <div class="list-pane">
      <div class="list-head"><h2>🍬 Treat stops nearby</h2><div class="list-tools"><span id="listCount" aria-live="polite">{{ homes|length }} showing</span><div class="view-toggle" role="group" aria-label="List layout"><button type="button" data-view="cards" aria-pressed="true" aria-label="Cards" title="Cards">▦</button><button type="button" data-view="compact" aria-pressed="false" aria-label="Compact list" title="Compact list">☰</button></div></div></div>
      <div class="list-sub" id="listSub">{% if homes|length == 0 %}No homes have listed yet — check back soon!{% else %}Self-reported by residents · tap a card to see it on the map{% endif %}</div>
      <ul class="cards" id="homeCards" aria-label="Participating homes">
        {% for home in homes %}{% include 'home/_card.html.twig' with {home: home, zones: zones} only %}{% else %}<li class="empty">No homes are listed yet. Residents can add theirs with “List your home”.</li>{% endfor %}
      </ul>
    </div>
    <div class="map-pane" id="mapPane">
      <div class="map-stage">
      <div class="map-fallback" id="mapFallback">Loading the map… The list of homes works without it.</div>
      <div class="map" id="map" role="region" aria-label="Map of participating homes"></div>
      <div class="map-logo">🗺️ {{ c.community.name }} <span>· {{ c.map.boundary_status == 'approved' ? 'neighborhood map' : 'map' }}</span></div>
      <div class="map-tools">
        <button type="button" id="btnFit" aria-label="Show the whole neighborhood" title="Show the whole neighborhood">⌖</button>
        <button type="button" id="btnZoomIn" aria-label="Zoom in" title="Zoom in">+</button>
        <button type="button" id="btnZoomOut" aria-label="Zoom out" title="Zoom out">−</button>
        <button type="button" id="btnLocate" aria-label="Show my location (stays on this device)" title="Show my location (stays on this device)">◎</button>
        <button type="button" data-action="info" aria-label="Map information" title="Map information">ⓘ</button>
      </div>
      <div class="map-selected" id="mapSelected" role="dialog" aria-label="Selected home"></div>
      <div class="map-legend" aria-hidden="true"><span><i class="legend-bullet candy"></i>🍬 Treats</span><span><i class="legend-bullet gentle"></i>🧩 Sensory-friendly</span><span><i class="legend-bullet spooky"></i>👻 Spooky</span></div>
      </div>
      <div class="map-footer"><span>⚠️ Listings are self-reported. Pins show only homes that chose to participate.</span><strong id="footerZones">{% if zs %}{{ zs.title }}{% endif %}</strong></div>
    </div>
  </div>
</section>

<div class="bottom-bar">
  <div><b>✨ Your Halloween, your way</b><p><span id="savedCount">0</span> saved stops · Plan a gentle stroll or a spooky adventure for you and your crew.</p></div>
  <div class="bottom-actions"><a class="secondary" href="#list-my-house" data-action="register">🏠 List your home</a><button type="button" class="route-btn" data-action="route">🧭 Build my route →</button></div>
</div>
<p class="disclaimer">Listings, hours and sensory details are self-reported by residents and may change. Favorites, filters and your start point stay only in this browser. Suggested stop orders are not walking directions—use sidewalks and safe crossings{% if c.community.gate_notice %}. {{ c.community.gate_notice }}{% else %}; this site does not grant access to gated areas{% endif %}.</p>
<script type="application/json" id="boot">{{ boot|boot_json }}</script>
{% endblock %}

{% block modals %}
{% include 'home/_modals.html.twig' %}
{% endblock %}

{% block scripts %}
<script src="/vendor/leaflet/leaflet.js" defer></script>
<script type="module" src="{{ asset_path('js/home.js') }}"></script>
{% endblock %}
