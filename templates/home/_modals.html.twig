{# Dialogs / mobile bottom sheets for the public page. All behaviour in assets/js/home.js + register.js. The event
   type supplies the words and the listing fields of step 2. #}
{% set reg = c.registration %}
{% set et = event_type(c.event.type) %}
<div class="modal-wrap" id="registerModal" role="dialog" aria-modal="true" aria-labelledby="registerTitle" hidden>
  <div class="modal">
    <button type="button" class="close-modal" data-close aria-label="Close">×</button>
    <div class="eyebrow">🏡 For {{ c.community.name }} residents</div>
    <h2 id="registerTitle">{{ et.copy.register_title }}</h2>
    <p class="introtext" id="registerIntro">No password needed. Pick your address, describe your stop, and confirm with a one-time link sent to your email. First verified neighbor for an address publishes it right away.</p>
    {% if reg.open %}<ol class="steps" aria-hidden="true"><li data-step-dot="1"></li><li data-step-dot="2"></li><li data-step-dot="3"></li></ol>{% endif %}

    {% if not reg.open %}
      <div class="notice" role="status">⏳ {{ reg.reason }}</div>
      <div class="modal-actions"><button type="button" class="secondary" data-close>Close</button></div>
    {% else %}
    <form id="registerForm" novalidate>
      <div class="hp-field" aria-hidden="true"><label for="regWebsite">Website</label><input id="regWebsite" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <fieldset data-step="1">
        <legend class="visually-hidden">Step 1 of 3: your address</legend>
        {% if reg.address_mode != 'self_entry' %}
        <div class="field full" id="lookupField">
          <label for="addrQuery">Home address *</label>
          <input id="addrQuery" autocomplete="off" placeholder="House number and street, e.g. 123 Pumpkin Ln…" maxlength="80" aria-describedby="addrHelp" aria-autocomplete="list" aria-controls="addrSuggestions">
          <span class="form-caption" id="addrHelp">Start with your house number. Only addresses in {{ c.community.name }} can be listed.</span>
          <ul class="suggestions" id="addrSuggestions" role="listbox" aria-label="Matching addresses"></ul>
          <span class="error" data-error="address"></span>
        </div>
        {% endif %}
        {% if reg.address_mode != 'registry' %}
        <div id="selfEntry" class="form-grid {{ reg.address_mode == 'both' ? 'hide' }}">
          <div class="field"><label for="seHouse">House number *</label><input id="seHouse" inputmode="numeric" maxlength="7" autocomplete="off"></div>
          <div class="field"><label for="seStreet">Street *</label><select id="seStreet"><option value="">Choose…</option>{% for s in reg.street_allowlist %}<option value="{{ s }}">{{ s }}</option>{% endfor %}</select></div>
          <div class="field"><label for="seUnit">Unit (optional)</label><input id="seUnit" maxlength="8" autocomplete="off"></div>
          {% if c.zones|length > 0 %}
          <div class="field"><label for="seZone">{{ zone_summary(c.zones) ? zone_summary(c.zones).title|split(' ')|last|capitalize : 'Zone' }}</label><select id="seZone"><option value="">Detect from pin</option>{% for z in c.zones %}{% if z.claimable %}<option value="{{ z.key }}">{{ z.label }}</option>{% endif %}{% endfor %}</select></div>
          {% endif %}
          <div class="field full">
            <span class="label" id="pinLabel">Tap your house on the map *</span>
            <div class="pin-map" id="pinMap" role="application" aria-labelledby="pinLabel"></div>
            <span class="form-caption">Place the pin on your roof. It must be inside the neighborhood boundary. Nothing is geocoded or guessed.{{ reg.review_new_addresses ? ' A new address appears on the map after an organizer approves it.' }}</span>
            <span class="error" data-error="pin"></span>
          </div>
        </div>
        {% if reg.address_mode == 'both' %}<button type="button" class="link-button" id="btnSelfEntry">Can’t find your address? Add it and place a pin{{ reg.review_new_addresses ? ' (an organizer approves it)' }}</button><button type="button" class="link-button hide" id="btnUseList">← Search the address list instead</button>{% endif %}
        {% endif %}
        {% if reg.address_mode == 'registry' and c.community.contact_url %}<p class="form-caption">Home missing from the list? <a href="{{ c.community.contact_url }}" rel="noopener">Contact the organizer</a> to add it.</p>{% endif %}
        <div id="claimedPanel" class="notice danger hide" role="alert">
          <b>This home is already claimed.</b> If you think this is a mistake, request a review. The organizer will follow up by email; the current owner is never shown.
          <div class="modal-actions"><button type="button" class="secondary" id="btnRequestReview">Request a review</button></div>
        </div>
        <div id="selectedAddress" class="success hide" role="status"></div>
        <div class="modal-actions"><button type="button" class="secondary" data-close>Cancel</button><button type="button" class="primary" data-next="2">Next: your stop →</button></div>
      </fieldset>

      <fieldset data-step="2" hidden>
        <legend class="visually-hidden">Step 2 of 3: your stop</legend>
        <div class="form-grid">
          <div class="field"><label for="regStart">Start time</label><select id="regStart">{% for h in range(et.hours.start[0], et.hours.start[1]) %}{% for m in ['00', '30'] %}{% set t = '%02d'|format(h) ~ ':' ~ m %}<option value="{{ t }}" {{ t == c.event.starts_at ? 'selected' }}>{{ t|time12 }}</option>{% endfor %}{% endfor %}</select></div>
          <div class="field"><label for="regEnd">End time</label><select id="regEnd">{% for h in range(et.hours.end[0], et.hours.end[1]) %}{% for m in ['00', '30'] %}{% set t = '%02d'|format(h) ~ ':' ~ m %}<option value="{{ t }}" {{ t == c.event.ends_at ? 'selected' }}>{{ t|time12 }}</option>{% endfor %}{% endfor %}</select></div>
          {% include event_fragment(c.event.type, 'form_fields') %}
          <div class="field full"><label for="regNote">Short public note (optional)</label><textarea id="regNote" maxlength="400" placeholder="{{ et.copy.note_placeholder }}"></textarea><span class="form-caption"><span id="noteCount">0</span>/400</span><span class="error" data-error="note"></span></div>
        </div>
        <div class="notice info">📍 Your street address, hours and these details will be <b>shown publicly</b> on the map. Your email is never shown.</div>
        <span class="error" data-error="end"></span>
        <div class="modal-actions"><button type="button" class="secondary" data-next="1">← Back</button><button type="button" class="primary" data-next="3">Next: confirm by email →</button></div>
      </fieldset>

      <fieldset data-step="3" hidden>
        <legend class="visually-hidden">Step 3 of 3: confirm by email</legend>
        <div class="field full"><label for="regEmail">Your email *</label><input id="regEmail" type="email" inputmode="email" spellcheck="false" autocapitalize="off" autocomplete="email" placeholder="neighbor@example.com" maxlength="254"><span class="error" data-error="email"></span>
          <p class="form-caption">We email you a one-time link (valid for a short time). Not shown to visitors. Use the same email later to edit your listing.</p></div>
        <div id="powStatus" class="hide" role="status" aria-live="polite"><span class="form-caption">Running a quick anti-spam check on your device…</span><div class="progress"><span id="powBar"></span></div></div>
        <div id="submitError" class="notice danger hide" role="alert"></div>
        <div class="modal-actions"><button type="button" class="secondary" data-next="2">← Back</button><button type="submit" class="primary" id="btnSendLink">Email me the confirmation link →</button></div>
      </fieldset>
    </form>
    <div id="registerSuccess" class="success hide" role="status" tabindex="-1"></div>
    {% endif %}
  </div>
</div>

<div class="modal-wrap" id="disputeModal" role="dialog" aria-modal="true" aria-labelledby="disputeTitle" hidden>
  <div class="modal">
    <button type="button" class="close-modal" data-close aria-label="Close">×</button>
    <div class="eyebrow">🔎 Review request</div>
    <h2 id="disputeTitle">Ask the organizer to review</h2>
    <p class="introtext" id="disputeIntro"><b id="disputeAddress"></b> is already claimed. Tell the organizer why you think this is a mistake. They review requests by hand; nothing changes automatically and the current owner is never revealed.</p>
    <form id="disputeForm" novalidate>
      <div class="hp-field" aria-hidden="true"><label for="dWebsite">Website</label><input id="dWebsite" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <div class="field full"><label for="dEmail">Your email *</label><input id="dEmail" type="email" inputmode="email" spellcheck="false" autocapitalize="off" autocomplete="email" maxlength="254"><span class="error" data-error="reporter_email"></span></div>
      <div class="field full"><label for="dReason">What happened? * (200–2000 characters)</label><textarea id="dReason" minlength="200" maxlength="2000"></textarea><span class="form-caption"><span id="dCount">0</span>/2000</span><span class="error" data-error="reason"></span></div>
      <div id="dPow" class="hide" role="status"><span class="form-caption">Running a quick anti-spam check…</span><div class="progress"><span id="dPowBar"></span></div></div>
      <div id="dError" class="notice danger hide" role="alert"></div>
      <div class="modal-actions"><button type="button" class="secondary" data-close>Cancel</button><button type="submit" class="primary">Send review request</button></div>
    </form>
    <div id="disputeSuccess" class="success hide" role="status" tabindex="-1"></div>
  </div>
</div>

<div class="modal-wrap" id="infoModal" role="dialog" aria-modal="true" aria-labelledby="infoTitle" hidden>
  <div class="modal">
    <button type="button" class="close-modal" data-close aria-label="Close">×</button>
    <div class="eyebrow">📋 Rules &amp; tips</div>
    <h2 id="infoTitle">Welcome, {{ c.community.name }}!</h2>
    {% set access = access_info(c.community.access ?? null, et.copy) %}
    <div class="guide-facts">
      <div class="about-fact"><span aria-hidden="true">{{ et.copy.event_icon }}</span><div><b>{{ event_badge(c.event.date)|lower|capitalize }}</b><p>Suggested {{ c.event.starts_at|time12 }}–{{ c.event.ends_at|time12 }} · each home sets its own hours</p></div></div>
      <div class="about-fact"><span aria-hidden="true">{{ access ? access.icon : '🚪' }}</span><div><b>{{ access ? access.title : 'Gates and private areas' }}</b><p>{{ c.community.gate_notice ?: (access ? access.text : 'This site does not grant access to gated areas.') }}</p></div></div>
      {% if c.map.crossing_notes %}<div class="about-fact"><span aria-hidden="true">🚸</span><div><b>Getting around</b>{% for note in c.map.crossing_notes %}<p>{{ note }}</p>{% endfor %}</div></div>{% endif %}
    </div>
    <h3 class="pref-heading">Reminders</h3>
    <ul class="reminders compact">{% for r in c.community.reminders|slice(0, 3) %}<li>{{ r }}</li>{% endfor %}</ul>
    <div class="modal-actions"><a class="secondary" href="/about">Full guide &amp; links</a><button type="button" class="primary" data-close>Got it!</button></div>
    <p class="form-caption guide-foot">{{ et.copy.guide_foot }}</p>
  </div>
</div>

<div class="modal-wrap" id="houseModal" role="dialog" aria-modal="true" aria-labelledby="houseTitle" hidden>
  <div class="modal">
    <button type="button" class="close-modal" data-close aria-label="Close">×</button>
    <div class="eyebrow">🏠 My house</div>
    <h2 id="houseTitle">Your listing</h2>
    <p class="introtext">{{ et.copy.house_intro }}</p>
    <div class="modal-actions"><a class="secondary" href="/me">🔑 Manage my listing</a><button type="button" class="primary" data-action="register">+ List my house</button></div>
  </div>
</div>
