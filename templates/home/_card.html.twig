{# Server-rendered house card (no-JS fallback); assets/js/lib/render.js renders the same markup. The event type's
   fragments draw the symbol and the tags. Expects `home`, `zones` and `type` (the event type key). #}
{%- set zone_label = null -%}
{%- for z in zones -%}{%- if z.key == home.zone -%}{%- set zone_label = z.label -%}{%- endif -%}{%- endfor -%}
{%- set statuses = event_type(type).statuses -%}
<li class="home-card" data-id="{{ home.id }}">
  <div class="card-symbol" aria-hidden="true">{% include event_fragment(type, 'card_symbol') %}</div>
  <div class="card-main">
    <div class="card-line"><b>{{ home.address }}</b></div>
    <div class="card-meta">{% if zone_label %}{{ zone_label }} · {% endif %}{{ home.start|time12 }}–{{ home.end|time12 }}{% if home.status != 'active' %} · {{ statuses[home.status].label ?? home.status }}{% endif %}</div>
    <div class="tags">
      {% include event_fragment(type, 'card_tags') %}
    </div>
    {% if home.note %}<p class="card-note">{{ home.note }}</p>{% endif %}
  </div>
</li>
