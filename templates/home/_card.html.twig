{# Server-rendered house card (no-JS fallback); assets/js/lib/render.js renders the same markup. #}
{%- set scary = home.jump_scares or home.scare_level == 'intense' -%}
{%- set zone_label = null -%}
{%- for z in zones -%}{%- if z.key == home.zone -%}{%- set zone_label = z.label -%}{%- endif -%}{%- endfor -%}
<li class="home-card" data-id="{{ home.id }}">
  <div class="card-symbol" aria-hidden="true">{{ scary ? '👻' : (home.low_noise ? '🍭' : '🎃') }}</div>
  <div class="card-main">
    <div class="card-line"><b>{{ home.address }}</b></div>
    <div class="card-meta">{% if zone_label %}{{ zone_label }} · {% endif %}{{ home.start|time12 }}–{{ home.end|time12 }}{% if home.status != 'active' %} · {{ {'paused': 'Paused', 'out_of_candy': 'Out of candy', 'done': 'Done for tonight'}[home.status] }}{% endif %}</div>
    <div class="tags">
      {% if home.candy %}<span class="tag candy">🍬 Candy</span>{% endif %}
      {% if home.low_noise %}<span class="tag quiet">💚 Low noise</span>{% endif %}
      {% if home.nonfood %}<span class="tag teal">🪀 Non-food</span>{% endif %}
      {% if home.scare_level == 'intense' %}<span class="tag spooky">👻 Intense scares</span>{% elseif home.scare_level == 'mild' %}<span class="tag spooky">🎃 Mild scares</span>{% endif %}
      {% if home.jump_scares %}<span class="tag spooky">😱 Jump scares</span>{% endif %}
      {% if home.flashing_lights %}<span class="tag strobe">⚡ Flashing</span>{% endif %}
      {% if home.loud_audio %}<span class="tag strobe">🔊 Loud audio</span>{% endif %}
      {% if home.adult_drinks %}<span class="tag drinks">🍺 21+</span>{% endif %}
      {% if home.stroller_friendly %}<span class="tag quiet">👶 Stroller-friendly</span>{% endif %}
    </div>
    {% if home.note %}<p class="card-note">{{ home.note }}</p>{% endif %}
  </div>
</li>
