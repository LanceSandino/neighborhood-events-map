{# Halloween listing options for "List my house" and "Manage my house". They mirror the map's filters and tags
   (same icons and words). defaults: pre-tick candy and low noise for a new listing. Expects `c`. #}
{% if c.features.candy %}<label class="check-chip"><input type="checkbox" name="candy"{{ defaults ? ' checked' }}> 🍬 Candy</label>{% endif %}
{% if c.features.nonfood_treats %}<label class="check-chip"><input type="checkbox" name="nonfood"> <span class="teal-pumpkin" aria-hidden="true">🎃</span> Non-food treats</label>{% endif %}
{% if c.features.adult_refreshments %}<label class="check-chip"><input type="checkbox" name="adult_drinks"> 🍺 21+ refreshments</label>{% endif %}
<label class="check-chip"><input type="checkbox" name="low_noise"{{ defaults ? ' checked' }}> 🧩 Sensory-friendly (quiet)</label>
<label class="check-chip"><input type="checkbox" name="jump_scares"> 😱 Jump scares</label>
<label class="check-chip"><input type="checkbox" name="flashing_lights"> 🔦 Flashing lights</label>
<label class="check-chip"><input type="checkbox" name="loud_audio"> 🔊 Loud audio</label>
<label class="check-chip"><input type="checkbox" name="stroller_friendly"> 👶 Kid-friendly</label>
