{# Halloween tags of the server-rendered card (no-JS fallback; lib/render.js draws the same words). Expects `home`. #}
{%- set scary = home.jump_scares or home.scare_level == 'intense' -%}
{%- set sensory = home.low_noise and not home.flashing_lights and not home.loud_audio and not scary -%}
{% if home.candy %}<span class="tag candy">🍬 Candy</span>{% endif %}
      {% if sensory %}<span class="tag quiet">🧩 Sensory-friendly</span>{% endif %}
      {% if home.nonfood %}<span class="tag teal" title="Teal pumpkin: non-food treats"><span class="teal-pumpkin" aria-hidden="true">🎃</span> Non-food</span>{% endif %}
      {% if home.scare_level == 'intense' or home.jump_scares %}<span class="tag spooky">😱 Big scares</span>{% elseif home.scare_level == 'mild' %}<span class="tag spooky">🎃 Mild scares</span>{% endif %}
      {% if home.flashing_lights %}<span class="tag strobe">🔦 Flashing lights</span>{% endif %}
      {% if home.loud_audio %}<span class="tag strobe">🔊 Loud audio</span>{% endif %}
      {% if home.adult_drinks %}<span class="tag drinks">🍺 21+</span>{% endif %}
      {% if home.stroller_friendly %}<span class="tag quiet">👶 Kid-friendly</span>{% endif %}
