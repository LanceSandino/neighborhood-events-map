{# Halloween hours of "List my house" step 2: the home's start and end time (one evening). Expects `c` and `et`. #}
<div class="field"><label for="regStart">Start time</label><select id="regStart">{% for h in range(et.hours.start[0], et.hours.start[1]) %}{% for m in ['00', '30'] %}{% set t = '%02d'|format(h) ~ ':' ~ m %}<option value="{{ t }}" {{ t == c.event.starts_at ? 'selected' }}>{{ t|time12 }}</option>{% endfor %}{% endfor %}</select></div>
          <div class="field"><label for="regEnd">End time</label><select id="regEnd">{% for h in range(et.hours.end[0], et.hours.end[1]) %}{% for m in ['00', '30'] %}{% set t = '%02d'|format(h) ~ ':' ~ m %}<option value="{{ t }}" {{ t == c.event.ends_at ? 'selected' }}>{{ t|time12 }}</option>{% endfor %}{% endfor %}</select></div>
