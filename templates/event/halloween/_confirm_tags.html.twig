{# Halloween tags of the listing a confirmation will publish (auth/confirm). Expects `l`, the stored draft. #}
{% if l.candy %}<span class="tag candy">{{ icon('i-candy') }} Candy</span>{% endif %}
          {% if l.nonfood %}<span class="tag teal" title="Teal pumpkin: non-food treats">{{ icon("i-pumpkin-teal") }} Non-food</span>{% endif %}
          {% if l.low_noise and not l.flashing_lights and not l.loud_audio and not l.jump_scares and l.scare_level != 'intense' %}<span class="tag quiet">{{ icon('i-sensory') }} Sensory-friendly</span>{% endif %}
          {% if l.scare_level == 'intense' or l.jump_scares %}<span class="tag spooky">{{ icon('i-scare-big') }} Big scares</span>{% elseif l.scare_level == 'mild' %}<span class="tag spooky">{{ icon("i-scare-mild") }} Mild scares</span>{% endif %}
          {% if l.flashing_lights %}<span class="tag strobe">{{ icon('i-flashing') }} Flashing lights</span>{% endif %}
          {% if l.loud_audio %}<span class="tag strobe">{{ icon('i-loud') }} Loud audio</span>{% endif %}
          {% if l.adult_drinks %}<span class="tag drinks">{{ icon('i-adult') }} 21+</span>{% endif %}
          {% if l.stroller_friendly %}<span class="tag quiet">{{ icon('i-stroller') }} Kid-friendly</span>{% endif %}
