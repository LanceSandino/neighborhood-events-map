{# Halloween tags of the listing a confirmation will publish (auth/confirm). Expects `l`, the stored draft. #}
{% if l.candy %}<span class="tag candy">🍬 Candy</span>{% endif %}
          {% if l.nonfood %}<span class="tag teal" title="Teal pumpkin: non-food treats"><span class="teal-pumpkin" aria-hidden="true">🎃</span> Non-food</span>{% endif %}
          {% if l.low_noise and not l.flashing_lights and not l.loud_audio and not l.jump_scares and l.scare_level != 'intense' %}<span class="tag quiet">🧩 Sensory-friendly</span>{% endif %}
          {% if l.scare_level == 'intense' or l.jump_scares %}<span class="tag spooky">😱 Big scares</span>{% elseif l.scare_level == 'mild' %}<span class="tag spooky">🎃 Mild scares</span>{% endif %}
          {% if l.flashing_lights %}<span class="tag strobe">🔦 Flashing lights</span>{% endif %}
          {% if l.loud_audio %}<span class="tag strobe">🔊 Loud audio</span>{% endif %}
          {% if l.adult_drinks %}<span class="tag drinks">🍺 21+</span>{% endif %}
          {% if l.stroller_friendly %}<span class="tag quiet">👶 Kid-friendly</span>{% endif %}
