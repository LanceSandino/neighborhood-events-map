{# Garage sale tags of a listing's details (cards, confirmation); events/garage_sale.js draws the same words. Icons are
   decorative; the words are always there (never colour only). No prices or photos. Expects `d`, the details. #}
{%- set cats = {kids_baby: ['i-kids-baby', 'Kids & baby'], toys: ['i-toys', 'Toys'], furniture: ['i-furniture', 'Furniture'], clothing: ['i-clothing', 'Clothing'], tools: ['i-tools', 'Tools'], books_media: ['i-books', 'Books & media'], electronics: ['i-electronics', 'Electronics'], sports: ['i-sports', 'Sports'], household: ['i-household', 'Household'], free: ['i-free', 'Free items']} -%}
{%- set pays = {cash: 'Cash', card: 'Card', apps: 'Apps'} -%}
{% for key in d.categories %}{% if cats[key] is defined %}<span class="tag cat">{{ icon(cats[key][0]) }} {{ cats[key][1] }}</span>{% endif %}{% endfor %}
      {% if d.multi_family %}<span class="tag family">{{ icon('i-multi-family') }} Multi-family</span>{% endif %}
      {% if d.early_birds_allowed %}<span class="tag early">{{ icon('i-bird') }} Early birds welcome</span>{% endif %}
      {% if d.payment_types %}<span class="tag pay" title="Payment kinds">{{ icon('i-cash') }} {{ d.payment_types|map(p => pays[p] ?? p)|join(' · ') }}</span>{% endif %}
