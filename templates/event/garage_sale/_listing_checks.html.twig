{# Garage sale listing details for "List my house" and "My house" (events/garage_sale.js reads them by name): the
   categories this sale allows (c.event.categories), multi-family and early birds, and the payment kinds (the kind
   only, never a username or phone number). The words mirror the map's filters and tags. Groups are fieldsets (no
   ids: My house repeats the form per home). Expects `c` and `et`. #}
{%- set cats = {kids_baby: ['i-kids-baby', 'Kids & baby'], toys: ['i-toys', 'Toys'], furniture: ['i-furniture', 'Furniture'], clothing: ['i-clothing', 'Clothing'], tools: ['i-tools', 'Tools'], books_media: ['i-books', 'Books & media'], electronics: ['i-electronics', 'Electronics'], sports: ['i-sports', 'Sports'], household: ['i-household', 'Household'], free: ['i-free', 'Free items']} -%}
<fieldset class="field full">
  <legend class="label">{{ et.copy.categories_label }} *</legend>
  <div class="checks">
    {% for key in c.event.categories ?? cats|keys %}{% if cats[key] is defined %}<label class="check-chip"><input type="checkbox" name="categories" value="{{ key }}"> {{ icon(cats[key][0]) }} {{ cats[key][1] }}</label>
    {% endif %}{% endfor %}
  </div>
  <span class="error" data-error="categories"></span>
</fieldset>
<fieldset class="field full">
  <legend class="label">Your sale</legend>
  <div class="checks">
    <label class="check-chip"><input type="checkbox" name="multi_family"> {{ icon('i-multi-family') }} Multi-family sale</label>
    <label class="check-chip"><input type="checkbox" name="early_birds_allowed"> {{ icon('i-bird') }} Early birds welcome</label>
  </div>
  <span class="form-caption">{{ et.copy.early_birds_help }}{% if c.event.early_bird_time ?? null %} {{ et.copy.early_bird_rule }} {{ c.event.early_bird_time|time12 }} (the organizer’s rule).{% endif %}</span>
</fieldset>
<fieldset class="field full">
  <legend class="label">Payment kinds</legend>
  <div class="checks">
    <label class="check-chip"><input type="checkbox" name="payment_types" value="cash"> {{ icon('i-cash') }} Cash</label>
    <label class="check-chip"><input type="checkbox" name="payment_types" value="card"> {{ icon('i-card') }} Card</label>
    <label class="check-chip"><input type="checkbox" name="payment_types" value="apps"> {{ icon('i-payment-app') }} Payment apps</label>
  </div>
  <span class="form-caption">{{ et.copy.payment_help }}</span>
  <span class="error" data-error="payment_types"></span>
</fieldset>
