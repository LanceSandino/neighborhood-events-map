{# Organizer console shell: reuses the public design tokens with the console's own neutral colours (admin.css); data
   via /api/admin/* (CSRF header). The chrome is the community's: its name and logo, else its initial, and a neutral
   icon — never an event's emoji, words or colours (no /theme.css here). An event's branding shows only where that event
   is in focus: Organizer → Events and the draft preview (D-20261031-52). #}
{%- set logo = c.branding.logo_url ?? null -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f7f4">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15141d">
  <script src="{{ asset_path('js/theme-init.js') }}"></script>
  <meta name="csrf-token" content="{{ csrf_token('nhm') }}">
  <title>{{ pages[page] }} · Organizer · {{ c.community.name }}</title>
  <link rel="icon" href="{{ logo ?? '/assets/img/favicon-community.svg' }}">
  {% block styles %}{% endblock %}
  <link rel="stylesheet" href="{{ asset_path('css/app.css') }}">
  <link rel="stylesheet" href="{{ asset_path('css/admin.css') }}">
</head>
<body class="admin">
<a class="skip-link" href="#main">Skip to content</a>
<header class="admin-top">
  <a class="brand" href="/admin"><div class="brand-icon community-mark{{ logo ? ' has-logo' }}" aria-hidden="true">{% if logo %}<img src="{{ logo }}" alt="">{% else %}{{ c.community.name|first|upper }}{% endif %}</div><div><div class="brand-name">{{ c.community.name }}</div><div class="brand-sub">Organizer console</div></div></a>
  <nav class="admin-tabs" aria-label="Organizer sections">
    {% for key, label in pages %}
      <a href="{{ {'overview': '/admin', 'events': '/admin/events', 'community': '/admin/community', 'map': '/admin/community/map', 'addresses': '/admin/addresses', 'disputes': '/admin/disputes', 'audit': '/admin/audit'}[key] }}" {% if key == page %}aria-current="page" class="active"{% endif %}>{{ label }}</a>
    {% endfor %}
  </nav>
  <div class="admin-actions"><a class="secondary" href="/">View site</a><a class="secondary" href="/me">My house</a><button type="button" class="secondary" id="btnLogout">Sign out</button></div>
</header>
<main class="admin-main" id="main" tabindex="-1">
  <h1>{{ pages[page] }}</h1>
  <div id="flash" role="status" aria-live="polite"></div>
  {% block body %}{% endblock %}
  <p class="footer-version">v{{ app_version }} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/accessibility">Accessibility</a></p>
</main>
{% block scripts %}{% endblock %}
</body>
</html>
