{% extends 'base.html.twig' %}
{% set nav = 'me' %}
{% block title %}Sign in · {{ c.community.name }} {{ c.event.name }}{% endblock %}
{% block body %}
<div class="page-card">
  <div class="eyebrow">🔑 Residents &amp; organizers</div>
  {% if expired %}
    <h1>Session expired</h1>
    <div class="notice" role="status">You were signed out after a period of inactivity. Email yourself a new sign-in link to continue.</div>
  {% else %}
    <h1>Manage your listing</h1>
    <p>No password needed. Enter the email you used to list your home and we’ll send a one-time sign-in link.</p>
  {% endif %}
  <form id="loginForm" novalidate>
    <div class="hp-field" aria-hidden="true"><label for="loginWebsite">Website</label><input id="loginWebsite" name="website" type="text" tabindex="-1" autocomplete="off"></div>
    <div class="field full"><label for="loginEmail">Email</label><input id="loginEmail" type="email" inputmode="email" spellcheck="false" autocapitalize="off" autocomplete="email" maxlength="254" required><span class="error" data-error="email"></span></div>
    <div id="powStatus" class="hide" role="status" aria-live="polite"><span class="form-caption">Running a quick anti-spam check on your device…</span><div class="progress"><span id="powBar"></span></div></div>
    <div id="loginError" class="notice danger hide" role="alert"></div>
    <div class="modal-actions"><a class="secondary" href="/">Back to map</a><button class="primary" type="submit">Email me a sign-in link</button></div>
  </form>
  <div id="loginSuccess" class="success hide" role="status" tabindex="-1"></div>
  <p class="form-caption">Links work once and expire after a few minutes. Signed-in sessions end after inactivity.</p>
</div>
{% endblock %}
{% block scripts %}<script type="module" src="{{ asset_path('js/login.js') }}"></script>{% endblock %}
