{% extends 'base.html.twig' %}
{# "My house": the resident's own homes (assets/js/me.js fills the template) for the event the page is about (the
   switcher above, ?e=<id>, else the default event; ADR 0011). The event type supplies the statuses and its listing
   fields. A home not listed for an upcoming or open event offers "List for <event>" with an empty form and, when the
   resident listed it for the previous event of the same type, "Use last year's details". A closed event is read-only.
   A hidden event (D-20261101-01) is shown here only: residents get ready while visitors see nothing yet. #}
{% set nav = 'me' %}
{% set switch_path = '/me' %}
{% set et = event_type(c.event.type) %}
{% block title %}My house · {{ c.community.name }} {{ c.event.name }}{% endblock %}
{% block meta %}<meta name="csrf-token" content="{{ csrf_token('nhm') }}">{% endblock %}
{# My house's own stylesheet: the colours of the event it names, a hidden one too (residents only). #}
{% block theme %}<link rel="stylesheet" href="/me/theme.css?v={{ app_version }}{{ event_query() ? '&' ~ event_query()|slice(1) }}">{% endblock %}
{% block body %}
<div class="dash" id="dashboard" data-event="{{ c.event.id ?? '' }}">
  <div class="dash-head">
    <div><div class="eyebrow">🔑 Signed in</div><h1>My house</h1><p class="session-hint" id="sessionHint">Loading…</p></div>
    <div class="bottom-actions"><a class="secondary hide" href="/admin" id="adminLink">Organizer console</a><button type="button" class="secondary" id="btnLogoutAll">Sign out everywhere</button><button type="button" class="secondary" id="btnLogout">Sign out</button></div>
  </div>
  {% if c.event.state == 'hidden' %}<p class="notice" id="eventHiddenNotice">Only residents see {{ c.event.name }} for now. Get your house ready: list it, or use last year’s details. Visitors see it once the organizer announces it, and homes appear on the map when it opens.</p>{% endif %}
  <p class="notice hide" id="eventNextNotice"></p>
  <div id="claimOutcome" role="status" tabindex="-1"></div>
  <div id="homes" aria-live="polite"><p class="empty">Loading your homes…</p></div>
  <div class="dash-home" id="listAnother">
    <h2 data-f="title">You don’t manage any homes yet</h2>
    <p class="introtext" data-f="text">Use the map’s “List your home” form while signed in. Your home appears here as soon as it is listed.</p>
    <a class="secondary" href="/#list-my-house">+ List a home</a>
  </div>
</div>
<template id="homeTemplate">
  <article class="dash-home">
    <h2 data-f="address"></h2>
    <p class="introtext" data-f="meta"></p>
    <p class="home-events hide" data-f="events"></p>
    <div class="notice hide" data-f="warning"></div>
    <div class="list-for hide" data-f="listFor"><p class="introtext" data-f="listForText"></p><button type="button" class="primary hide" data-f="listForButton"></button></div>
    <div class="copy-previous hide" data-f="copyBox"><p class="introtext">You listed this home last time. Start from those details, check them and save — nothing is shown until you save.</p><button type="button" class="secondary" data-f="copyPrevious">Use last year’s details</button></div>
    <div class="status-row" role="group" aria-label="{{ et.copy.status_group }}">
      {%- for key, s in et.statuses %}
      <button type="button" class="secondary" data-status="{{ key }}">{{ s.icon }} {{ s.label }}</button>
      {%- endfor %}
    </div>
    <form class="form-grid" data-f="form" novalidate>
      {% include event_fragment(c.event.type, 'manage_hours') %}
      {% include event_fragment(c.event.type, 'manage_half') %}
      <div class="field"><label>Visible on the map<select name="published"><option value="true">Yes, show my home</option><option value="false">No, hide it for now</option></select></label></div>
      {% include event_fragment(c.event.type, 'manage_full') %}
      <div class="field full"><label>Short public note<textarea name="note" maxlength="400"></textarea></label></div>
      <div class="field full"><div class="notice danger hide" data-f="error" role="alert"></div>
        <div class="modal-actions"><button type="button" class="danger" data-f="release">Give up this home</button><button type="submit" class="primary" data-f="save">Save changes</button></div></div>
    </form>
  </article>
</template>
{% endblock %}
{% block scripts %}<script type="module" src="{{ asset_path('js/me.js') }}"></script>{% endblock %}
